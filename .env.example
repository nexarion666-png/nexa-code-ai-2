# Nexa Code AI — optional build/deployment configuration
# AI keys are entered by each user in Settings and are not required here.

# GitHub OAuth App
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GITHUB_REDIRECT_URI=http://localhost:3000/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/github/callback

# Vercel BYOK: do NOT set VERCEL_TOKEN. Users enter their own token in Settings.

# Supabase Auth (Phase 6)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
